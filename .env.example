GEMINI_API_KEY=
QDRANT_API_KEY=
JWT_SECRET=change-me-in-production

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/legal_db

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_CANADA_COLLECTION=canada

# Embedding / vectors (must match Canada ingest: BGE-M3 dense + learned sparse)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=8
BGE_M3_USE_FP16=false
BGE_M3_MAX_LENGTH=8192
DENSE_VECTOR_NAME=text-dense
SPARSE_VECTOR_NAME=text-sparse

# Gemini generation
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
INGEST_PROMPT_CHARS=8000

# Retriever tuning
ALLOW_GENERAL_LEGAL_ANSWERS=true
SKIP_RETRIEVAL_FOR_GENERIC=true
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_DOCUMENT=15
RETRIEVAL_TOP_K_AMBIGUOUS=8
RETRIEVAL_TOP_K_HYBRID_CASE=10
RETRIEVAL_TOP_K_HYBRID_LEGIS=10
RETRIEVAL_TOP_K_SCENARIO_CASE=12
RETRIEVAL_TOP_K_SCENARIO_LEGIS=12
ANSWER_TOP_K=10
MMR_LAMBDA=0.7
RRF_K=60

# Ingestion
MULTI_INPUT_ROOT=./input_documents
INGEST_BATCH_SIZE=50
QDRANT_UPSERT_BATCH=100
INGEST_MAX_RETRIES=3

# Optional S3 (Canada PDFs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-east-1
S3_BUCKET=
S3_FOLDER_PATH=public/canada/cases
CA_LEGIS_S3_FOLDER_PATH=public/canada/legislation

# Local PDF storage
PDF_STORAGE_DIR=../storage/pdfs

# Evaluation harness
GEMINI_JUDGE_MODEL=gemini-2.5-flash
EVAL_GOLDEN_DIR=./evaluation/golden
EVAL_OUTPUT_DIR=./evaluation/reports
EVAL_CONCURRENCY=1
EVAL_PASS_THRESHOLD_FAITHFULNESS=0.8
EVAL_PASS_THRESHOLD_RELEVANCY=0.7
EVAL_PASS_THRESHOLD_PRECISION=0.6
ADMIN_API_TOKEN=change-me-for-eval
